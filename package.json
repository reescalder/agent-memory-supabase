{
  "name": "agent-memory-supabase",
  "version": "0.2.0",
  "description": "Production-shaped long-term memory for AI agents on Supabase Postgres: pgvector + full-text hybrid recall (RRF), entity grounding, temporal validity, trigram dedup. Ships an MCP server for Claude. You own the SQL.",
  "type": "module",
  "main": "src/client.js",
  "exports": {
    ".": "./src/client.js"
  },
  "bin": {
    "agent-memory-mcp": "src/mcp-server.js"
  },
  "files": [
    "src",
    "sql",
    "README.md",
    "AGENT_SETUP.md",
    "LICENSE"
  ],
  "scripts": {
    "example": "node examples/quickstart.js",
    "mcp": "node src/mcp-server.js",
    "test": "node --test"
  },
  "keywords": [
    "supabase",
    "postgres",
    "pgvector",
    "ai",
    "agent",
    "memory",
    "rag",
    "embeddings",
    "vector-search",
    "hybrid-search",
    "mcp",
    "model-context-protocol",
    "claude"
  ],
  "author": "Rees Calder <reescalder.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^17.4.2",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=18"
  }
}
