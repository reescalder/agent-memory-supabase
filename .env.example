# Supabase project (Project Settings -> API Keys)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret key (sb_secret_...) or legacy service_role key: server-side only.
# Bypasses RLS. NEVER expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI, for embeddings (text-embedding-3-small) and optional entity extraction
OPENAI_API_KEY=sk-...
